{
  "name": "Home Assistant",
  "version": "2.0.0",
  "description": "Control and monitor Home Assistant entities",
  "author": "PyDeck Team",
  "min_pydeck_version": "1.1.0",
  "max_pydeck_version": null,
  "changelog": "CHANGELOG.md",
  "functions": {
    "toggle": {
      "label": "HA Toggle",
      "description": "Toggle a Home Assistant entity on/off",
      "disableGallary": true,
      "disableGallery": true,
      "default_display": {
        "color": "#1a3a6e",
        "text": ""
      },
      "ui": [
        {
          "type": "api_select",
          "id": "domain_filter",
          "label": "Domain",
          "api": "domains",
          "display": {
            "label": "label",
            "value": "value"
          },
          "default": ""
        },
        {
          "type": "api_select",
          "id": "entity_id",
          "label": "Entity",
          "api": "entities",
          "filter_field": "domain_filter",
          "filter_by": "domain",
          "display": {
            "label": "name",
            "value": "entity_id"
          },
          "default": ""
        },
        {
          "type": "group",
          "id": "toggle_display_group",
          "label": "Display",
          "fields": [
            {
              "type": "checkbox",
              "id": "show_label",
              "label": "Name / Title",
              "default": true
            }
          ]
        }
      ],
      "pdk": true,
      "poll": {
        "function": "on_poll",
        "interval_ms": 3000
      }
    },
    "display": {
      "label": "HA Display",
      "description": "Show a Home Assistant entity's current value (read-only)",
      "disableGallary": true,
      "disableGallery": true,
      "default_display": {
        "color": "#1a3a6e",
        "text": ""
      },
      "ui": [
        {
          "type": "api_select",
          "id": "domain_filter",
          "label": "Domain",
          "api": "domains",
          "display": {
            "label": "label",
            "value": "value"
          },
          "default": ""
        },
        {
          "type": "api_select",
          "id": "entity_id",
          "label": "Entity",
          "api": "entities",
          "filter_field": "domain_filter",
          "filter_by": "domain",
          "display": {
            "label": "name",
            "value": "entity_id"
          },
          "default": ""
        },
        {
          "type": "group",
          "id": "display_display_group",
          "label": "Display",
          "fields": [
            {
              "type": "checkbox",
              "id": "show_icon",
              "label": "Entity Icon",
              "default": true
            },
            {
              "type": "checkbox",
              "id": "show_label",
              "label": "Name / Title",
              "default": false
            }
          ]
        }
      ],
      "pdk": true,
      "poll": {
        "function": "on_poll",
        "interval_ms": 3000
      }
    }
  },
  "pdk": true,
  "python_dependencies": [
    "Pillow"
  ],
  "credentials": [
    {
      "id": "url",
      "label": "Home Assistant URL",
      "type": "text"
    },
    {
      "id": "token",
      "label": "Long-Lived Access Token",
      "type": "password"
    }
  ],
  "permissions": {
    "urllib.request": [
      "urlopen",
      "Request"
    ],
    "urllib.error": [
      "HTTPError",
      "URLError"
    ],
    "urllib.parse": [
      "urlparse"
    ],
    "json": [
      "dumps",
      "loads"
    ],
    "hashlib": [
      "md5"
    ],
    "pathlib": [
      "Path"
    ]
  },
  "documentation": "DOCS.md",
  "show_markdown_after_install": true
}
