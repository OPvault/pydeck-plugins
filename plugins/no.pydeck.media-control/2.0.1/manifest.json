{
  "name": "Media Control",
  "version": "2.0.1",
  "description": "Control media playback on Linux (play/pause, next, previous, volume)",
  "author": "PyDeck Team",
  "min_pydeck_version": "1.1.0",
  "max_pydeck_version": null,
  "changelog": "CHANGELOG.md",
  "documentation": "DOCS.md",
  "show_markdown_after_install": false,
  "permissions": {
    "shutil": ["which"],
    "subprocess": ["run"],
    "threading": ["Lock"],
    "re": ["compile"],
    "time": ["monotonic"]
  },
  "functions": {
    "play": {
      "label": "Play",
      "description": "Start playback",
      "sidebar_icon": "assets/icons/Play.png",
      "default_display": { "color": "#2a2a2e", "text": "" },
      "ui": [
        {
          "type": "input",
          "id": "player",
          "label": "Player",
          "placeholder": "All players",
          "default": ""
        }
      ]
    },
    "pause": {
      "label": "Pause",
      "description": "Pause playback",
      "sidebar_icon": "assets/icons/Pause.png",
      "default_display": { "color": "#2a2a2e", "text": "" },
      "ui": [
        {
          "type": "input",
          "id": "player",
          "label": "Player",
          "placeholder": "All players",
          "default": ""
        }
      ]
    },
    "play_pause": {
      "label": "Play/Pause",
      "description": "Toggle playback — the glyph follows the player's status",
      "sidebar_icon": "assets/icons/PlayPause.png",
      "default_display": { "color": "#2a2a2e", "text": "" },
      "poll": { "function": "on_poll", "interval_ms": 2000 },
      "ui": [
        {
          "type": "input",
          "id": "player",
          "label": "Player",
          "placeholder": "All players",
          "default": ""
        },
        {
          "type": "radio",
          "id": "track_label",
          "label": "Track Label",
          "default": "none",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "song", "label": "Song" },
            { "value": "song_artist", "label": "Song - Artist" },
            { "value": "artist", "label": "Artist" }
          ]
        }
      ]
    },
    "next_track": {
      "label": "Next Track",
      "description": "Skip to the next track",
      "sidebar_icon": "assets/icons/Next.png",
      "default_display": { "color": "#2a2a2e", "text": "" },
      "ui": [
        {
          "type": "input",
          "id": "player",
          "label": "Player",
          "placeholder": "All players",
          "default": ""
        }
      ]
    },
    "previous_track": {
      "label": "Previous Track",
      "description": "Go to the previous track",
      "sidebar_icon": "assets/icons/Previous.png",
      "default_display": { "color": "#2a2a2e", "text": "" },
      "ui": [
        {
          "type": "input",
          "id": "player",
          "label": "Player",
          "placeholder": "All players",
          "default": ""
        }
      ]
    },
    "volume_up": {
      "label": "Volume Up",
      "description": "Increase volume",
      "sidebar_icon": "assets/icons/VolumeUp.png",
      "default_display": { "color": "#2a2a2e", "text": "" },
      "poll": { "function": "on_poll", "interval_ms": 3000 },
      "ui": [
        {
          "type": "number",
          "id": "step_percent",
          "label": "Volume Step (%)",
          "min": 1,
          "max": 50,
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "show_volume_label",
          "label": "Show Volume %",
          "default": false
        }
      ]
    },
    "volume_down": {
      "label": "Volume Down",
      "description": "Decrease volume",
      "sidebar_icon": "assets/icons/VolumeDown.png",
      "default_display": { "color": "#2a2a2e", "text": "" },
      "poll": { "function": "on_poll", "interval_ms": 3000 },
      "ui": [
        {
          "type": "number",
          "id": "step_percent",
          "label": "Volume Step (%)",
          "min": 1,
          "max": 50,
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "show_volume_label",
          "label": "Show Volume %",
          "default": false
        }
      ]
    },
    "mute_toggle": {
      "label": "Toggle Mute",
      "description": "Toggle mute on the default audio sink",
      "sidebar_icon": "assets/icons/Mute.png",
      "disableGallary": false,
      "disableGallery": false,
      "default_display": { "color": "#2a2a2e", "text": "" },
      "poll": { "function": "on_poll", "interval_ms": 3000 },
      "ui": [],
      "display_states": {
        "default": {
          "image": "plugins/plugin/no.pydeck.media-control/assets/icons/Volume.png"
        },
        "active": {
          "image": "plugins/plugin/no.pydeck.media-control/assets/icons/Mute.png"
        }
      }
    }
  },
  "compatibility": {"os": ["linux"], "requires": ["dbus", "mpris"]}
}
