{
  "name": "Updates",
  "version": "0.1.1",
  "description": "Pending package updates from every installed package manager on one key",
  "author": "PyDeck Team",
  "min_pydeck_version": "2.0.0",
  "max_pydeck_version": null,
  "changelog": "CHANGELOG.md",
  "functions": {
    "counter": {
      "label": "Updates",
      "description": "Pending package updates across every installed package manager; press to re-check or upgrade",
      "sidebar_icon": "assets/icons/updates.svg",
      "title_readonly": true,
      "disableGallary": true,
      "disableGallery": true,
      "default_display": {
        "color": "#161b22",
        "text": "",
        "scroll_enabled": false
      },
      "poll": {
        "function": "on_poll",
        "interval_ms": 2000
      },
      "ui": [
        {
          "type": "group",
          "id": "behavior",
          "label": "Behavior",
          "fields": [
            {
              "type": "number",
              "id": "interval_minutes",
              "label": "Check every (minutes)",
              "default": 30,
              "min": 1,
              "max": 1440
            },
            {
              "type": "select",
              "id": "press_action",
              "label": "On press",
              "default": "refresh",
              "options": [
                {
                  "label": "Re-check now",
                  "value": "refresh"
                },
                {
                  "label": "Open a terminal and upgrade",
                  "value": "update"
                },
                {
                  "label": "Upgrade, then re-check",
                  "value": "both"
                }
              ]
            },
            {
              "type": "input",
              "id": "terminal",
              "label": "Terminal",
              "placeholder": "alacritty",
              "default": "alacritty"
            }
          ]
        },
        {
          "type": "group",
          "id": "appearance",
          "label": "Appearance",
          "fields": [
            {
              "type": "input",
              "id": "label",
              "label": "Label",
              "default": "Updates"
            },
            {
              "type": "checkbox",
              "id": "show_breakdown",
              "label": "Show per-manager breakdown",
              "default": true
            },
            {
              "type": "number",
              "id": "warn_at",
              "label": "Warning from (0 = never)",
              "default": 10,
              "min": 0,
              "max": 100000
            },
            {
              "type": "number",
              "id": "crit_at",
              "label": "Critical from (0 = never)",
              "default": 50,
              "min": 0,
              "max": 100000
            },
            {
              "type": "select",
              "id": "status_colors",
              "label": "Status colors",
              "default": "global",
              "options": [
                {
                  "label": "Use global",
                  "value": "global"
                },
                {
                  "label": "Custom",
                  "value": "custom"
                }
              ],
              "description": "Use global follows Settings → Plugin settings → Shared."
            },
            {
              "type": "group",
              "id": "status_colors_custom",
              "label": "Custom colors",
              "layout": "row",
              "visible_if": {
                "field": "status_colors",
                "value": "custom"
              },
              "fields": [
                {
                  "type": "color",
                  "id": "color_ok",
                  "label": "Good",
                  "default": "#7ee787"
                },
                {
                  "type": "color",
                  "id": "color_warn",
                  "label": "Warning",
                  "default": "#ffd166"
                },
                {
                  "type": "color",
                  "id": "color_crit",
                  "label": "Critical",
                  "default": "#ff6b6b"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "permissions": {
    "subprocess": [
      "run",
      "Popen",
      "DEVNULL",
      "TimeoutExpired"
    ],
    "threading": [
      "Thread",
      "Lock"
    ],
    "shutil": [
      "which"
    ],
    "os": [
      "environ"
    ],
    "time": [
      "monotonic",
      "sleep"
    ],
    "re": [
      "compile"
    ],
    "shlex": [
      "split"
    ]
  },
  "compatibility": {
    "os": [
      "linux"
    ]
  }
}
